generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  // Conexión con pool: la que usa la app en cada request.
  url       = env("DATABASE_URL")
  // Conexión directa: la que usan las migraciones (el pool las rompe).
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  CARGADOR
  CALLER
  ENCARGADO   // jefe de un grupo: cobra 10% de las ventas de su gente
  PROCESADOR  // procesa el pago de la venta: cobra 10% de esa venta
}
enum EstadoLead {
  PENDIENTE
  NO_CONTESTO
  VOLVER_A_LLAMAR
  ACEPTO
  NO_QUISO
}

model Usuario {
  id             String    @id @default(cuid())
  usuario        String    @unique
  nombre         String
  rol            Rol
  hash           String
  telefono       String?   // WhatsApp en formato E.164: 5491155554444
  telegramId     String?   @unique // chat_id, se completa solo al hacer /start
  codigoTg       String?   @unique // código de vinculación de un solo uso
  notificar      Boolean   @default(true)
  ventanaHasta   DateTime? // fin de la ventana de servicio de 24 h
  activo         Boolean   @default(true)
  creadoEn       DateTime  @default(now())
  leadsCargados  Lead[]    @relation("cargador")
  leadsAsignados Lead[]    @relation("caller")
  llamadas       Llamada[]
  avisos         Aviso[]
  suscripciones  Suscripcion[]
  eventos        Evento[]
  ultimoLatido   DateTime?

  // Un encargado tiene a cargo a varios callers y spamers.
  encargado      Usuario?  @relation("equipo", fields: [encargadoId], references: [id])
  encargadoId    String?
  equipo         Usuario[] @relation("equipo")

  // Ventas que esta persona procesó como procesador de pago.
  procesadas     Llamada[] @relation("procesador")
  pagos          Pago[]
  sesionActual   String?   // id de la única sesión válida: al entrar en otro lado, la anterior muere
}

model Lead {
  id            Int        @id @default(autoincrement())
  nombre        String
  dni           String     // puede repetirse: la misma persona con dos teléfonos
  telefono      String     @unique
  nota          String?
  estado        EstadoLead @default(PENDIENTE)
  intentos      Int        @default(0)
  proximoAviso  DateTime?
  avisosHoy     Int        @default(0)
  enLlamadaDesde DateTime? // lo marca el caller al confirmar que va a llamar
  cargadoPor    Usuario    @relation("cargador", fields: [cargadoPorId], references: [id])
  cargadoPorId  String
  asignadoA     Usuario    @relation("caller", fields: [asignadoAId], references: [id])
  asignadoAId   String
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
  llamadas      Llamada[]

  @@index([dni])
  @@index([asignadoAId, estado])
  @@index([proximoAviso])
}

model Llamada {
  id        Int        @id @default(autoincrement())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    Int
  caller    Usuario    @relation(fields: [callerId], references: [id])
  callerId  String
  resultado    EstadoLead
  monto        Float?   // soles cobrados al cliente (obligatorio cuando aceptó)
  procesador   Usuario? @relation("procesador", fields: [procesadorId], references: [id])
  procesadorId String?
  referencia   String?  // nº de operación, voucher o comprobante
  validada     Boolean  @default(false) // el admin confirmó que el dinero entró
  anulada      Boolean  @default(false) // venta caída: no cuenta para comisión ni ranking
  revisadoPor  String?
  revisadoEn   DateTime?
  nota         String?
  duracion     Int      @default(0)  // segundos entre "voy a llamar" y el resultado
  abiertoEn    DateTime @default(now()) // cuándo confirmó que iba a llamar
  creadoEn     DateTime @default(now())
  desdeIp      String?
  agente       String?

  @@index([callerId, creadoEn])
}

/// Bitácora de todo lo que hace cada persona: entradas, aperturas, resultados, inactividad.
model Evento {
  id        Int      @id @default(autoincrement())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  tipo      String   // login, logout, abrio_ficha, descarto_ficha, resultado, cancelo, inactivo, latido
  leadId    Int?
  detalle   String?
  segundos  Int?
  ip        String?
  creadoEn  DateTime @default(now())

  @@index([usuarioId, creadoEn])
  @@index([tipo, creadoEn])
}

model Aviso {
  id        Int      @id @default(autoincrement())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String
  tipo      String
  canal     String
  cuerpo    String
  entregado Boolean  @default(false)
  error     String?
  creadoEn  DateTime @default(now())
}

model Auditoria {
  id       Int      @id @default(autoincrement())
  usuario  String
  rol      String
  accion   String
  detalle  String
  creadoEn DateTime @default(now())
}

model Config {
  clave String @id
  valor String
}

model Suscripcion {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  agente    String?
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

/// Cada pago que el admin le hace a un trabajador. El saldo pendiente
/// sale de restar los pagos a lo devengado, así se puede pagar cualquier día.
model Pago {
  id         Int      @id @default(autoincrement())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId  String
  monto      Float
  concepto   String?
  metodo     String?  // efectivo, yape, transferencia...
  referencia String?
  lote       String?  // agrupa los pagos hechos juntos, para la boleta
  detalle    String?  // foto del cálculo al momento de pagar (JSON)
  creadoPor  String
  creadoEn   DateTime @default(now())

  @@index([usuarioId, creadoEn])
  @@index([lote])
}
