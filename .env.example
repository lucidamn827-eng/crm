# --- Base de datos (Neon, Supabase o Vercel Postgres) ---
# La "pooled": termina en -pooler.  La usa la app.
DATABASE_URL="postgresql://usuario:clave@host-pooler.neon.tech/db?sslmode=require"
# La directa: el MISMO host pero SIN -pooler.  La usan las migraciones.
DIRECT_URL="postgresql://usuario:clave@host.neon.tech/db?sslmode=require"

# --- Sesiones ---
JWT_SECRET="cadena-larga-y-aleatoria-min-32-caracteres"

# --- Cron (Vercel la crea sola; si usás un cron externo, poné la misma acá) ---
CRON_SECRET="otra-cadena-aleatoria"

# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN="token-permanente-de-la-app-de-meta"
WA_PHONE_ID="id-del-numero-emisor"
WA_VERIFY_TOKEN="palabra-que-elijas-para-verificar-el-webhook"
WA_PLANTILLA_AVISO="aviso_contacto_asignado"   # plantilla UTILITY aprobada por Meta
WA_IDIOMA_PLANTILLA="es"

# --- Operación ---
TZ_OPERACION="America/Argentina/Buenos_Aires"

# --- Telegram (recomendado: gratis y sin plantillas) ---
TG_TOKEN="el-token-que-te-da-@BotFather"
TG_SECRETO="cadena-aleatoria-para-el-webhook"

# --- Notificaciones push de la web (generalas con: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BJ...clave-publica"
VAPID_PRIVATE_KEY="clave-privada"
VAPID_SUBJECT="mailto:vos@tudominio.com"
